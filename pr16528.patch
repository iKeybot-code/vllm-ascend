+#    Future Plan:
+#       Remove together with fix 2 once upstream splits mamba-align pages
+#       without the EAGLE backoff on PD producers.
 #
 # ** 9. File: platform/patch_kv_cache_utils.py**
 # ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
diff --git a/vllm_ascend/patch/platform/patch_kv_cache_coordinator.py b/vllm_ascend/patch/platform/patch_kv_cache_coordinator.py
index d8e121effd92..40a337fedda3 100644
